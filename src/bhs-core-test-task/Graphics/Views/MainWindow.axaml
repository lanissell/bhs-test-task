<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Graphics.ViewModels"
        xmlns:views="clr-namespace:Graphics.Views"
        mc:Ignorable="d" d:DesignWidth="100" d:DesignHeight="100"
        x:Class="Graphics.Views.MainWindow"
        x:DataType="viewModels:EdgesViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Graphics"
        MinWidth="800"
        MinHeight="600"
        MaxWidth="800"
        MaxHeight="600"
        CanResize="False">

    <Design.DataContext>
        <viewModels:EdgesViewModel />
    </Design.DataContext>

    <views:DrawingControl Edges="{Binding Edges}"/>

</Window>